rules_version = '2';

// Reglas de seguridad de Firestore para Creaciones Kathy.
// Solo las cuentas de esta lista pueden leer y escribir fichas y configuración.
// Cópialas en Firebase → Firestore Database → Reglas y cambia los correos.
service cloud.firestore {
  match /databases/{database}/documents {
    function delTaller() {
      return request.auth != null
        && request.auth.token.email in [
          'CORREO_DE_KATHY@ejemplo.com',
          'TU_CORREO@ejemplo.com'
        ];
    }

    match /fichas/{uid} {
      allow read, write: if delTaller();
    }

    match /ajustes/{id} {
      allow read, write: if delTaller();
    }
  }
}
